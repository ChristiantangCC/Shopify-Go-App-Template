# Copy to .env, or just run `bun run app:start:dev`: it fills most of this in.

# The app's public base URL. In development this is the tunnel URL, written
# by `bun run app:start:dev` (the Shopify CLI tunnel) on every start.
HOST=

# From the Dev Dashboard, under the app's Settings.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin API version the app speaks.
# SHOPIFY_API_VERSION=2026-10

# Postgres. docker-compose.yml provides this locally.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable

# Optional Redis: caches shop installs and settings (5 minutes) and shares
# the App Proxy rate limit across instances. Postgres stays the source of
# truth; leave it empty to run without a cache. docker-compose.yml provides
# it locally.
REDIS_URL=redis://localhost:6379/0

# Encrypts access and refresh tokens at rest. Generate with:
#   openssl rand -hex 32
# Losing it means every shop must reopen the app once to reconnect.
ENCRYPTION_KEY=

# Earlier ENCRYPTION_KEY values, comma separated, kept only while the
# re-encrypt job moves tokens to the new key. See docs/key-rotation.md.
# ENCRYPTION_KEYS_OLD=

# Optional billing module (see internal/handlers/billing.go).
# BILLING_ENABLED=true
# SHOPIFY_APP_HANDLE=go-app-template

# Optional server-to-server API keys for /api/service routes.
# API_KEY=
# API_KEYS=flow:<key>,erp:<key>

# App Proxy replay window and per-caller rate limit.
# PROXY_MAX_AGE=5m
# RATE_LIMIT_PER_MINUTE=30
# How many proxies append to X-Forwarded-For in front of the app: 2 for
# Shopify's App Proxy plus your own reverse proxy, 1 with none.
# PROXY_TRUSTED_HOPS=2

# Set by `bun run app:start:dev` so the Go server proxies the UI to Vite (hot
# reload). Never set in production.
# FRONTEND_DEV_URL=http://localhost:5173

# json (default) or text.
# LOG_FORMAT=text
# LOG_LEVEL=debug

# Keep serving this long after SIGTERM with /readyz failing, so a load
# balancer drains the instance first (e.g. 10s on Kubernetes).
# SHUTDOWN_DRAIN_DELAY=0s

# PORT=8080
