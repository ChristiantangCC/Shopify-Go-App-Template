# Copy to .env, or just run `pnpm app:start:dev`: it fills most of this in.

# The app's public base URL. In development this is the tunnel URL, written
# by `pnpm app:start:dev` (the Shopify CLI tunnel) on every start.
HOST=

# From the Dev Dashboard, under the app's Settings.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin API version the app speaks.
# SHOPIFY_API_VERSION=2026-07

# Postgres. docker-compose.yml provides this locally.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable

# Encrypts access and refresh tokens at rest. Generate with:
#   openssl rand -hex 32
# Losing it means every shop must reopen the app once to reconnect.
ENCRYPTION_KEY=

# Optional billing module (see internal/handlers/billing.go).
# BILLING_ENABLED=true
# SHOPIFY_APP_HANDLE=go-app-template

# Optional server-to-server API keys for /api/service routes.
# API_KEY=
# API_KEYS=flow:<key>,erp:<key>

# App Proxy replay window and per-caller rate limit.
# PROXY_MAX_AGE=5m
# RATE_LIMIT_PER_MINUTE=30

# Set by `pnpm app:start:dev` so the Go server proxies the UI to Vite (hot
# reload). Never set in production.
# FRONTEND_DEV_URL=http://localhost:5173

# json (default) or text.
# LOG_FORMAT=text
# LOG_LEVEL=debug

# PORT=8080
