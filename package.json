{
  "name": "shopify-go-app-template",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "web/frontend",
    "extensions/*"
  ],
  "scripts": {
    "app:start:dev": "bash scripts/link-dev.sh && shopify app dev --config dev",
    "dev": "bun run app:start:dev",
    "new-app": "bash scripts/new-app.sh",
    "generate:extension": "bash scripts/generate-extension.sh",
    "app:deploy:dev": "shopify app deploy --config dev",
    "app:deploy:prod": "shopify app deploy",
    "codegen": "go run ./scripts/fetch-schema && cd internal/shopify/graphql && go tool genqlient",
    "check:toml": "bun scripts/check-toml.ts",
    "db:generate": "go run github.com/sqlc-dev/sqlc/cmd/sqlc@v1.30.0 generate",
    "frontend:dev": "bun run --cwd web/frontend dev",
    "frontend:build": "bun run --cwd web/frontend build",
    "typecheck": "bun run --cwd web/frontend typecheck",
    "test": "go test ./...",
    "db:up": "docker compose up -d --wait postgres"
  }
}
